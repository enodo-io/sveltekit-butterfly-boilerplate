{
  "name": "@enodo/sveltekit-butterfly-boilerplate",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "setup": "npm run setup:env && npm run setup:breakpoints",
    "setup:env": "node scripts/setup-env.js",
    "setup:breakpoints": "node scripts/setup-breakpoints.js",
    "generate:favicons": "node scripts/generate-favicons.js",
    "predev": "npm run setup:breakpoints",
    "prebuild": "npm run setup:breakpoints",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "git config core.hooksPath .githooks || true; svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint .",
    "test:unit": "vitest",
    "test": "npm run test:unit -- --run && npm run test:e2e",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@enodo/butterfly-tracker": "^1.0.0",
    "@enodo/butterfly-ts": "^1.1.2",
    "@eslint/compat": "^2.0.2",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/open-sans": "^5.2.7",
    "@fontsource/fira-mono": "^5.2.7",
    "@fontsource/poppins": "^5.2.7",
    "@lucide/svelte": "^1.7.0",
    "@playwright/test": "^1.49.1",
    "@sentry/replay": "^11.10.0",
    "@sentry/sveltekit": "^11.10.0",
    "@sveltejs/adapter-node": "5.5.6",
    "@sveltejs/kit": "^2.22.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^24.19.2",
    "@vitest/browser-playwright": "^5.1.0",
    "cacheable-lookup": "^7.0.0",
    "deep-pagination": "^1.0.1",
    "dotenv": "^18.0.9",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-svelte": "^3.0.0",
    "feed": "^6.0.0",
    "globals": "^17.4.0",
    "marked": "^15.0.12",
    "mustache": "^4.2.0",
    "playwright": "^1.53.0",
    "prettier": "^3.4.2",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sass": "^1.93.2",
    "schema-dts": "^2.0.0",
    "sharp": "^0.35.5",
    "sitemap": "^10.0.0",
    "slugify": "^1.6.6",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "svelte-inview": "^4.0.4",
    "tailwindcss": "^4.1.18",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.56.0",
    "undici": "^7.30.2",
    "vite": "^8.3.5",
    "vite-plugin-devtools-json": "^1.0.0",
    "vitest": "^5.1.0",
    "vitest-browser-svelte": "^3.1.0"
  },
  "dependencies": {
    "@enodo/tailwindcss-foundation": "^1.0.0"
  }
}
